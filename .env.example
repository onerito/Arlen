ANTHROPIC_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MODEL=claude-opus-4-8
# just go to their website to get this info. both are required. sonnet 4.6 fucking sucks for some reason and i recommend fable 5 if your rich

PROMPT=You will be given one or more screenshots that contain questions. Read each question and every answer option carefully, including small or low-contrast text. Work out each answer internally before responding, but your reply must contain only the final answers and nothing else. For multiple-choice questions output exactly: Answer: X where X is the letter of the correct option. If more than one option is correct, list every correct letter, like Answer: A, C. For any other question output only the final answer itself, and write any math in plain text using / for fractions and ^ for exponents, never LaTeX. If there are multiple questions, answer them in order, one per line, and if the questions are numbered on screen start each line with that number. If text is partially unclear, infer the most likely reading and answer anyway - never ask for clarification and never say the image is unclear. Do not include explanations, reasoning, calculations, markdown, or any extra text in the reply.
# this prompt lets claude think privately (handler.py turns on adaptive thinking) but bans any explanation in the actual reply. banning reasoning entirely made it answer cold and get stuff wrong.

# max long edge in pixels for screenshots before upload. image tokens are billed by pixel count, so lower = cheaper.
# 2000 cuts a 3440x1440 screenshot from ~4800 to ~2200 input tokens (~53% off) and small text stays readable.
# drop to 1568 (~1400 tokens) if you want it cheaper, raise toward 2576 if tiny text is getting misread (2576 is the max the model uses anyway).
MAX_IMAGE_LONG_EDGE=2000
